# ARCHIVOS PYTHON
# ===============================

__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.tmp
*.swp
.ipynb_checkpoints/

# ===============================
# JUPYTER
# ===============================

.ipynb_checkpoints

# ===============================
# DATOS SENSIBLES (MUY IMPORTANTE)
# ===============================

data/raw_pdfs/
data/raw_text/
data/structured/
data/validation/

*.pdf
*.xlsx
*.csv
*.json

# ===============================
# MODELOS ENTRENADOS
# ===============================

models/
*.h5
*.pt
*.pth
*.ckpt
*.joblib
*.pkl

# ===============================
# REPORTES GENERADOS
# ===============================

reports/
*.html

# ===============================
# SISTEMA OPERATIVO
# ===============================

.DS_Store
Thumbs.db

# ===============================
# VS CODE
# ===============================

.vscode/

# ===============================
# BUILD / CACHE
# ===============================

build/
dist/
*.egg-info/

# ===============================
# EXCEPCIONES: RESULTADOS ESTRUCTURADOS
# ===============================
# Se versionan los Excel de data/structured/ (base oficial y tabulado de
# resultados). Los PDFs crudos, el texto OCR y validation/ siguen ignorados
# por tamano y por contener datos personales.

!data/structured/
!data/structured/*.xlsx

# ===============================
# CARPETAS TEMPORALES DE PRUEBA
# ===============================
# Carpetas de validacion/prueba con datos personales; nunca se versionan.
data/_prueba_*/
data/_batch_test/

# ===============================
# CONTEXTO CATASTRAL / TESIS
# ===============================
# Documentacion de referencia (modelos IGAC, PDFs, .tex de la tesis): son
# insumos pesados, no codigo. Se ignoran salvo el diccionario de destinos,
# que es dependencia real del pipeline de consolidacion.
data/contexto_catastral/*
!data/contexto_catastral/general_destinacion_economica.txt
data/contexto_tesis/

# ===============================
# CARPETA DE COMPARACION
# ===============================
# Los datos consolidados y reportes de comparacion son artefactos generados y
# pesados (base consolidada ~94MB, con datos personales). Se ignoran.
data/comparacion/

# Scripts temporales de diagnostico
scripts/_*.py
